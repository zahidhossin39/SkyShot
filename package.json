{
  "name": "screenshot-app",
  "private": true,
  "license": "MIT",
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "tauri": "tauri",
    "check:fast": "tsc --noEmit && npm test",
    "check:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test --lib",
    "check": "npm run check:fast && npm run check:rust",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/api": "^2",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
