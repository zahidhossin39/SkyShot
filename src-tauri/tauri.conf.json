{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shutter",
  "version": "0.2.1",
  "identifier": "com.zaid-hossain.screenshot-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/history/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2OTM1RTE2QjhFNTZGMDEKUldRQmIrVzRGbDZUaG9tQ3hlSWhlODRFVUhMemE4bHhTSmJNYXlORjdIeDBKZURoZ0RqNEZVS3IK",
      "endpoints": [
        "https://github.com/zahidhossin39/shutter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
